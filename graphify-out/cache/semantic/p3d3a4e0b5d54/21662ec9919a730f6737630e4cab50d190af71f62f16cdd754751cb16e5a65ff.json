: null, "contributor": null, "rationale": "Callers pin reusable workflows to a full commit SHA with the release tag in a comment so Dependabot keeps both SHA and version current; every uses: must be SHA-pinned."}, {"id": "readme_dependabot", "label": "Dependabot", "file_type": "concept", "source_file": "README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_job_names_as_interface", "label": "Job names are part of the interface", "file_type": "rationale", "source_file": "README.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rulesets require checks by job name (security-baseline / workflow-lint etc., and bump), so renaming a job breaks required checks and is a major version."}, {"id": "readme_scanner_checksum_pinning", "label": "Scanner binaries pinned by version and SHA-256", "file_type": "rationale", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependabot does not bump scanner binaries downloaded inside the workflow, so version and checksum must be updated together manually."}, {"id": "readme_bump_pin_workflow", "label": "bump-pin reusable workflow", "file_type": "concept", "source_file": "README.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bump_pin_script", "label": "scripts/bump-pin.sh (pin edit)", "file_type": "concept", "source_file": "README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ensure_bump_pr_script", "label": "scripts/ensure-bump-pr.sh (branch, PR, auto-merge)", "file_type": "concept", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bump_pin_tests", "label": "tests/bump-pin.sh", "file_type": "concept", "source_file": "README.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ensure_bump_pr_tests", "label": "tests/ensure-bump-pr.sh", "file_type": "concept", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_homelab_managment_target", "label": "Rue-Asha/Homelab-Managment (default target repo)", "file_type": "concept", "source_file": "README.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_upward_only_pin", "label": "Upward-only pin with semver validation", "file_type": "rationale", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pin only moves upward: an older tag is skipped, a pre-release tag or equal value ends green with no change, and a tag or pin not in vMAJOR.MINOR.PATCH form fails the job."}, {"id": "readme_superseded_pr_cleanup", "label": "Closing older bump/<variable>-* PRs", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only older-tag bump PRs are closed; newer ones and branches with unparseable tags are left alone."}, {"id": "readme_bump_concurrency_group", "label": "concurrency group bump-<variable>", "file_type": "concept", "source_file": "README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jobs for the same variable run one at a time, queued and never cancelled, so no bump is lost."}, {"id": "readme_idempotent_rerun", "label": "Idempotent re-run completes half-finished bumps", "file_type": "rationale", "source_file": "README.md", "source_location": "L50", "